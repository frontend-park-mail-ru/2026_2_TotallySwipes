{
  "name": "totally-swipes-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:templates": "handlebars src/blocks -e hbs -f src/templates.js",
    "watch:templates": "chokidar \"src/blocks/**/*.hbs\" -c \"npm run build:templates\"",
    "prestart": "npm run build:templates",
    "start": "node server/server.js",
    "predev": "npm run build:templates",
    "dev": "concurrently -n templates,server -c magenta,cyan \"npm:watch:templates\" \"node --watch server/server.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.2.1",
    "handlebars": "^4.7.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
