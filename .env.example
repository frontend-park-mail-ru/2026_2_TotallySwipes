# Адрес API бэкенда.
VITE_API_URL=

# Включает моки вместо бэкенда, только для разработки: true или false.
VITE_USE_MOCKS=false

# Ключ Яндекс.Карт (JavaScript API 3.0). В ограничении по HTTP Referer должны быть localhost и домен сайта.
# Локально его нужно положить в .env.local, на сервере он передаётся при сборке образа из секрета GitHub YANDEX_MAPS_API_KEY.
VITE_YANDEX_MAPS_API_KEY=
