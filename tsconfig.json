{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],

        "noEmit": true,
        "isolatedModules": true,
        "strict": true,
        "skipLibCheck": true,

        "allowJs": true,
        "checkJs": false
    },
    "include": ["src", "env.d.ts"]
}
