<header class="chat__header" hidden>
    <a class="chat__peer" data-link>
        <img class="chat__avatar chat__photo" alt="" width="40" height="40" hidden>
        <span class="chat__avatar chat__initial" aria-hidden="true" hidden></span>
        <span class="chat__name">
            <span class="chat__name-text"></span><span class="chat__age" hidden></span>
        </span>
    </a>
    <div class="chat__actions">
        <a class="button button_view_secondary button_size_l chat__meeting" data-link>
            <img class="button__icon" src="/icons/calendar.svg" alt="" width="20" height="20">
            <span class="button__text">Назначить встречу</span>
        </a>
        <button class="button button_view_outline button_size_l button_icon-only chat__more" type="button" aria-label="Ещё" disabled>
            <img class="button__icon" src="/icons/dots.svg" alt="" width="20" height="20">
        </button>
    </div>
</header>
<div class="chat__body">{{{body}}}</div>
{{{composer}}}
