<div class="login-form">
    <h2 class="login-form__title">С возвращением</h2>
    <p class="login-form__subtitle">Войдите, чтобы продолжить знакомства.</p>
    <form class="login-form__form" novalidate>
        {{{email}}}
        {{{password}}}
        <p class="login-form__error" role="alert" hidden></p>
        <button class="button login-form__submit" type="submit">Войти</button>
    </form>
    <p class="login-form__footer">
        Ещё нет аккаунта?
        <a class="login-form__link" href="/register" data-link>Зарегистрироваться</a>
    </p>
</div>
