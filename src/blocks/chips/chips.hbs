<div class="chips {{mix}}">
    {{#each chips}}
        <label class="chips__item{{#if color}} chips__item_accent chips__item_{{color}}{{/if}}">
            <input class="chips__input" type="{{../type}}" name="{{../name}}" value="{{value}}">
            <span class="chips__label">{{#if icon}}<span class="chips__icon" style="--icon: url('{{icon}}')"></span>{{/if}}{{text}}</span>
        </label>
    {{/each}}
</div>
