<div class="chips {{mix}}">
    {{#each options}}
        <label class="chips__item{{#if accent}} chips__item_accent chips__item_{{accent}}{{/if}}">
            <input class="chips__input" type="{{../type}}" name="{{../name}}" value="{{value}}">
            <span class="chips__label">{{#if icon}}{{{icon}}}{{/if}}{{label}}</span>
        </label>
    {{/each}}
</div>
