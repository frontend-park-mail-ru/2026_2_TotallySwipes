<div class="user-preview {{mix}}">
    {{#if photo_url}}
        <img class="user-preview__avatar" src="{{photo_url}}" alt="">
    {{else}}
        <span class="user-preview__avatar">{{initial}}</span>
    {{/if}}
    <div class="user-preview__info">
        <span class="user-preview__name"><span class="user-preview__name-text">{{name}}</span>,&nbsp;{{age}}</span>
        {{#if city}}
            <span class="user-preview__city">{{city}}</span>
        {{/if}}
    </div>
</div>
