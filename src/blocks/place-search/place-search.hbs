<div class="place-search__header">
    <div class="place-search__heading">
        <a class="button button_view_outline button_size_l button_icon-only place-search__back" href="/matches" data-link>
            <span class="button__icon button__icon_mask" style="--icon: url('/icons/arrow-left.svg')"></span>
        </a>
        <h1 class="place-search__title">Куда пойдём?</h1>
    </div>
    <div class="place-search__counter"></div>
</div>

<div class="place-search__content">
    <div class="place-search__voting" hidden>
        <div class="place-search__stack swipe-stack"></div>

        <div class="place-search__actions">
            {{{actions}}}
        </div>
    </div>

    <div class="place-search__screen"></div>
</div>
