<form class="profile-edit" novalidate>
    <div class="profile-edit__header">
        <h1 class="profile-edit__title">Профиль</h1>
        <div class="profile-edit__actions">
            <button class="button button_view_primary button_size_l profile-edit__save" type="submit" disabled>
                <span class="button__text">Сохранить изменения</span>
            </button>
            <p class="profile-edit__saved" hidden>
                <span class="profile-edit__saved-icon" style="--icon: url('/icons/check.svg')"></span>
                Все изменения сохранены
            </p>
        </div>
    </div>
    <div class="profile-edit__content"></div>
    <div class="profile-edit__footer">
        <button type="button" class="button button_view_soft button_size_l profile-edit__logout">
            <span class="button__text">Выйти</span>
        </button>
    </div>
</form>
