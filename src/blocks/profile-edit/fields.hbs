<div class="profile-edit__cards">
    <section class="card card_gap_l">
        <h2 class="card__title">Анкета</h2>
        <div class="profile-edit__fields">
            {{{name}}}
            <div class="form-field">
                <label class="form-field__label" for="profile-birth-day">Дата рождения</label>
                <div class="profile-edit__date">
                    <input class="form-field__input" id="profile-birth-day" name="day" type="text" inputmode="numeric" maxlength="2" autocomplete="bday-day">
                    <select class="form-field__input form-field__input_select" name="month" autocomplete="bday-month">
                        {{#each months}}
                            <option value="{{value}}">{{label}}</option>
                        {{/each}}
                    </select>
                    <input class="form-field__input" name="year" type="text" inputmode="numeric" maxlength="4" autocomplete="bday-year">
                </div>
                <p class="form-field__hint profile-edit__age-hint">{{ageHint}}</p>
                <p class="form-field__error" hidden></p>
            </div>
        </div>
    </section>

    {{{location}}}

    <section class="card card_gap_l">
        <h2 class="card__title">О себе</h2>
        <div class="form-field">
            <textarea class="form-field__input form-field__input_textarea" name="about"></textarea>
            <div class="profile-edit__note">
                <p class="form-field__hint">Чем живёте и кого ищете — с этого часто начинают разговор</p>
                <span class="profile-edit__counter"></span>
            </div>
            <p class="form-field__error" hidden></p>
        </div>
    </section>

    <section class="card card_gap_l">
        <div class="card__header">
            <h2 class="card__title">Интересы</h2>
            <span class="card__counter profile-edit__interests-count"></span>
        </div>
        <div class="form-field">
            {{{interests}}}
            <p class="form-field__error" hidden></p>
        </div>
        <p class="profile-edit__hint">Выберите до {{interestsMax}} интересов — по ним проще начать разговор.</p>
    </section>

    <section class="card card_gap_l">
        <h2 class="card__title">Основное</h2>
        <div class="profile-edit__fields">
            <div class="profile-edit__row">
                {{{height}}}
                <div class="form-field">
                    <label class="form-field__label" for="profile-education">Образование</label>
                    <select class="form-field__input form-field__input_select" id="profile-education" name="education">
                        <option value="">Не указано</option>
                        {{#each educations}}
                            <option value="{{key}}">{{label}}</option>
                        {{/each}}
                    </select>
                    <p class="form-field__error" hidden></p>
                </div>
            </div>
            {{{work}}}
            <div class="form-field">
                <span class="form-field__label">Цель знакомства</span>
                {{{datingGoal}}}
                <p class="form-field__error" hidden></p>
            </div>
            <div class="form-field">
                <span class="form-field__label">Курение</span>
                {{{smoking}}}
                <p class="form-field__error" hidden></p>
            </div>
            <div class="form-field">
                <span class="form-field__label">Алкоголь</span>
                {{{alcohol}}}
                <p class="form-field__error" hidden></p>
            </div>
        </div>
    </section>
</div>
