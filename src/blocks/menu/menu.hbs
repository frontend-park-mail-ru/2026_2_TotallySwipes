<ul class="menu {{mix}}">
    {{#each items}}
        <li class="menu__item">
            <a class="menu__link{{#if disabled}} menu__link_disabled{{/if}}"{{#unless disabled}} href="{{href}}" data-link{{/unless}}>
                <span class="menu__icon">{{{icon}}}</span>
                <span class="menu__text">{{text}}</span>
                {{#if counter}}{{#unless disabled}}
                    <span class="counter menu__counter">{{counter}}</span>
                {{/unless}}{{/if}}
            </a>
        </li>
    {{/each}}
</ul>
