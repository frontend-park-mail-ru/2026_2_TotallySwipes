<article class="profile-card {{mix}}" data-id="{{id}}">
    <div class="profile-card__gallery">
        {{#each imgPath}}
            <img class="profile-card__photo {{#if @first}}profile-card__photo_visible{{/if}}" src="{{this}}" alt="photo" draggable="false">
        {{/each}}

        {{{pager}}}
        <img class="profile-card__swipe-stamp profile-card__swipe-stamp_type_like" src="/icons/stamp-yes.svg" alt="" draggable="false">
        <img class="profile-card__swipe-stamp profile-card__swipe-stamp_type_dislike" src="/icons/stamp-no.svg" alt="" draggable="false">
        <img class="profile-card__swipe-stamp profile-card__swipe-stamp_type_super" src="/icons/stamp-super.svg" alt="" draggable="false">

        {{#if hasCompatibility}}
            <div class="match-stamp match-stamp_color_{{matchColor}} profile-card__stamp">
                <img class="match-stamp__image" src="/icons/badge-compat-{{matchColor}}.svg" alt="" draggable="false">
                <span class="match-stamp__value">{{compatibility}}%</span>
            </div>
        {{/if}}

    </div>

    <div class="profile-card__info{{#if infoMix}} {{infoMix}}{{/if}}">
        <div class="profile-card__summary">
            <div class="profile-card__title">
                <span class="profile-card__name">{{name}}</span>,&nbsp;<span class="profile-card__age">{{age}}</span>
            </div>
            {{{location}}}
        </div>
        <button class="button button_view_outline button_icon-only profile-card__expand" type="button" title="Подробнее">
            <span class="button__icon button__icon_mask" style="--icon: url('/icons/chevron-up.svg')"></span>
        </button>
    </div>
</article>
