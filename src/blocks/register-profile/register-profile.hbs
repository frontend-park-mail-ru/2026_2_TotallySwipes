{{{name}}}
<div class="form-field">
    <label class="form-field__label" for="register-birth-day">Дата рождения</label>
    <div class="register-profile__date">
        <input class="form-field__input" id="register-birth-day" name="day" type="text" inputmode="numeric" maxlength="2" placeholder="ДД" autocomplete="bday-day">
        <select class="form-field__input form-field__input_select" name="month" required autocomplete="bday-month">
            <option value="" disabled selected>Месяц</option>
            {{#each months}}
                <option value="{{value}}">{{label}}</option>
            {{/each}}
        </select>
        <input class="form-field__input" name="year" type="text" inputmode="numeric" maxlength="4" placeholder="ГГГГ" autocomplete="bday-year">
    </div>
    <p class="form-field__error" hidden></p>
</div>
<div class="form-field">
    <span class="form-field__label">Пол</span>
    {{{sex}}}
    <p class="form-field__error" hidden></p>
</div>
