<section class="card card_gap_l profile-photos">
    <div class="card__header">
        <h2 class="card__title">Фото</h2>
        <span class="card__counter profile-photos__count"></span>
    </div>
    <div class="profile-photos__gallery"></div>
    <div class="form-field">
        <input class="profile-photos__file" type="file" accept="{{accept}}" multiple hidden>
        <input class="profile-photos__replace-file" type="file" accept="{{accept}}" hidden>
        <p class="profile-photos__hint">Перетащите миниатюру, чтобы поменять порядок. Первое фото — главное: его видят в анкетах.</p>
        <p class="form-field__error" hidden></p>
    </div>
</section>
