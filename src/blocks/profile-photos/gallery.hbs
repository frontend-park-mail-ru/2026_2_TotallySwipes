<div class="profile-photos__stage">
    <img class="profile-photos__image" src="{{main}}" alt="" draggable="false">
    {{#if isMain}}
        <span class="profile-photos__badge">
            <span class="profile-photos__badge-icon" style="--icon: url('/icons/star_filled.svg')"></span>
            Главное фото
        </span>
    {{/if}}
    <div class="profile-photos__tools">
        <button class="button profile-photos__tool profile-photos__replace" type="button"{{#if locked}} disabled{{/if}}>
            <span class="button__icon button__icon_mask" style="--icon: url('/icons/camera.svg')"></span>
            <span class="button__text">Заменить</span>
        </button>
        <button class="button profile-photos__tool profile-photos__remove" type="button"{{#if removeDisabled}} disabled{{/if}}>
            <span class="button__icon button__icon_mask" style="--icon: url('/icons/x.svg')"></span>
            <span class="button__text">Удалить</span>
        </button>
    </div>
</div>
<div class="profile-photos__thumbs{{#if locked}} profile-photos__thumbs_locked{{/if}}">
    {{#each slots}}
        {{#if url}}
            <div class="profile-photos__thumb profile-photos__thumb_filled{{#if active}} profile-photos__thumb_active{{/if}}" draggable="{{#if @root.locked}}false{{else}}true{{/if}}" data-index="{{index}}">
                <img class="profile-photos__thumb-image" src="{{url}}" alt="" draggable="false">
                <span class="profile-photos__thumb-index">{{number}}</span>
            </div>
        {{else}}
            <button class="profile-photos__thumb profile-photos__thumb_empty" type="button"{{#if @root.locked}} disabled{{/if}}>
                {{{@root.plusIcon}}}
            </button>
        {{/if}}
    {{/each}}
</div>
