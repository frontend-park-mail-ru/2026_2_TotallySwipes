<div class="search-filter {{mix}}">
    <div class="form-field">
        <span class="form-field__label">Показывать</span>
        {{{sex}}}
        <p class="form-field__error" hidden></p>
    </div>
    <div class="form-field">
        <label class="form-field__label" for="{{id}}-age-from">Возраст</label>
        <div class="search-filter__age">
            <span class="search-filter__age-text">от</span>
            <input class="form-field__input search-filter__age-input" id="{{id}}-age-from" name="ageFrom" type="text" inputmode="numeric" maxlength="3" placeholder="22">
            <span class="search-filter__age-text">до</span>
            <input class="form-field__input search-filter__age-input" name="ageTo" type="text" inputmode="numeric" maxlength="3" placeholder="28">
            <span class="search-filter__age-text">лет</span>
        </div>
        <p class="form-field__error" hidden></p>
    </div>
</div>
