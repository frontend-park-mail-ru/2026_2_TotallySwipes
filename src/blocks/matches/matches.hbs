<div class="matches__header">
    <h1 class="matches__title">Симпатии</h1>
    <span class="matches__count"></span>
</div>

<div class="matches__grid">

</div>

<button type="button" class="button button_view_outline matches__more matches__more_hidden">
    <span class="button__text">Загрузить ещё</span>
</button>

<div class="matches__empty">
    <div class="empty-state">
        <img class="empty-state__image" src="/icons/card-mascot-sky.svg" alt="">
        <div class="empty-state__title">
            Симпатий пока нет
        </div>
        <p class="empty-state__text">Ставьте лайки в анкетах — когда симпатия окажется взаимной, она появится здесь</p>

        <div class="empty-state__actions">
            <a href="/" data-link class="button button_view_primary empty-state__button matches__feed-link">
                <span class="button__text">Смотреть анкеты</span>
            </a>
        </div>
    </div>
</div>
