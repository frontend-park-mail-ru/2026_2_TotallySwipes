<div class="feed__main">
    <div class="feed__header">
        <h1 class="feed__title">Анкеты</h1>

        <button type="button" class="button button_view_outline">
            <img class="button__icon" src="/public/icons/sliders.svg" alt="">
            <span class="button__text">Девушки, 22–28</span>
            <span class="button__hint">· до 10 км</span>
        </button>
        
        <button type="button" class="button button_view_outline">
            <img class="button__icon" src="/public/icons/sort.svg" alt="">
            <span class="button__text">По совместимости</span>
        </button>
    </div>

    <div class="feed__stack">
        
    </div>

    <div class="feed__actions">
        {{{actions}}}
    </div>

    <div class="feed__empty">
        {{{emptyState}}}
    </div>
</div>

<aside class="feed__details">
    {{{details}}}   
</aside>
