<nav class="steps {{mix}}" aria-label="Прогресс теста">
    {{#each items}}
        <button type="button" class="steps__item steps__item_color_{{color}}{{#if state}} steps__item_state_{{state}}{{/if}}" data-index="{{@index}}">
            <span class="steps__bar"></span>
            <span class="steps__label">
                <span class="steps__check"></span>
                {{number}}
            </span>
        </button>
    {{/each}}
</nav>
