<nav class="steps{{#if isInteractive}} steps_interactive{{/if}} {{mix}}">
    {{#each items}}
        <{{../itemTag}} class="steps__item steps__item_color_{{color}} steps__item_state_{{state}}"{{#if ../isInteractive}} type="button" data-index="{{@index}}"{{/if}}>
            <span class="steps__bar"></span>
            <span class="steps__label">
                <span class="steps__check"></span>
                {{number}}
            </span>
        </{{../itemTag}}>
    {{/each}}
</nav>
