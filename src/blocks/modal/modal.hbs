<dialog class="modal">
    {{#if image}}
        <img class="modal__image" src="{{image}}" alt="">
    {{/if}}
    <div class="modal__content">
        <h2 class="modal__title">{{title}}</h2>
        <p class="modal__text">{{text}}</p>
    </div>
    <form class="modal__actions" method="dialog">
        {{#if cancelText}}
            <button class="button button_view_ghost modal__button" value="cancel">
                <span class="button__text">{{cancelText}}</span>
            </button>
        {{/if}}
        <button class="button button_view_primary modal__button" value="confirm">
            <span class="button__text">{{buttonText}}</span>
        </button>
    </form>
</dialog>
