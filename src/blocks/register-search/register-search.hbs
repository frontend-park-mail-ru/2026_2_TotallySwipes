<div class="form-field">
    <span class="form-field__label">Показывать</span>
    {{{searchSex}}}
    <p class="form-field__error" hidden></p>
</div>
<div class="form-field">
    <label class="form-field__label" for="register-age-from">Возраст</label>
    <div class="register-search__age">
        <span class="register-search__age-text">от</span>
        <input class="form-field__input register-search__age-input" id="register-age-from" name="ageFrom" type="text" inputmode="numeric" maxlength="3" placeholder="22">
        <span class="register-search__age-text">до</span>
        <input class="form-field__input register-search__age-input" name="ageTo" type="text" inputmode="numeric" maxlength="3" placeholder="28">
        <span class="register-search__age-text">лет</span>
    </div>
    <p class="form-field__error" hidden></p>
</div>
<div class="form-field">
    <span class="form-field__label">Цель знакомства</span>
    {{{datingIntent}}}
    <p class="form-field__error" hidden></p>
</div>
