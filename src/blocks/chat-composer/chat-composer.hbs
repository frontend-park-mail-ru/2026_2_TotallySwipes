<form class="chat-composer chat__composer" hidden>
    <input class="chat-composer__input" type="text" placeholder="Напишите сообщение" aria-label="Сообщение">
    <button class="button button_view_plain button_size_l button_icon-only chat-composer__record" type="button" aria-label="Записать голосовое" disabled>
        <img class="button__icon chat-composer__icon" src="/icons/microphone.svg" alt="" width="20" height="20">
    </button>
    <button class="button button_view_primary button_size_l button_icon-only chat-composer__send" type="submit" aria-label="Отправить сообщение" hidden>
        <img class="button__icon chat-composer__icon" src="/icons/arrow-up.svg" alt="" width="20" height="20">
    </button>
</form>
