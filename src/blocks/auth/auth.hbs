<div class="auth">
    <section class="auth__intro">
        <a class="logo auth__logo" href="/" data-link>swipes.</a>
        <div class="auth__pitch">
            <h1 class="auth__headline">Знакомства, где видно, что вы совпадаете.</h1>
            <p class="auth__lead">Пройдите короткий тест, и рядом с каждой анкетой появится процент совместимости. Нравится — свайп вправо.</p>
        </div>
        <div class="auth__art">
            <img class="auth__sticker auth__sticker_mascot" src="/public/stickers/card-mascot-sun.svg" width="210" alt="">
            <img class="auth__sticker auth__sticker_badge" src="/public/badges/badge-swipe-right.svg" width="136" alt="">
            <img class="auth__sticker auth__sticker_star" src="/public/stickers/star-pink.svg" width="112" alt="">
            <span class="pill pill_lilac auth__pill auth__pill_test">
                <svg class="pill__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3.5l1.6 4.4L16 9.5l-4.4 1.6L10 15.5l-1.6-4.4L4 9.5l4.4-1.6Z"/><path d="M18 14l.8 2.2L21 17l-2.2.8L18 20l-.8-2.2L15 17l2.2-.8Z"/></svg>
                Тест совместимости
            </span>
            <span class="pill pill_sky auth__pill auth__pill_nearby">
                <svg class="pill__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                Анкеты рядом
            </span>
            <span class="pill pill_pink auth__pill auth__pill_matches">
                <svg class="pill__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                Взаимные симпатии
            </span>
        </div>
    </section>
    <section class="auth__panel">
        <div class="auth__card">
            <nav class="auth__tabs">
                <a class="auth__tab auth__tab_active" href="/login" data-link>Вход</a>
                <a class="auth__tab" href="/register" data-link>Регистрация</a>
            </nav>
            {{{form}}}
        </div>
    </section>
</div>
